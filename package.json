{
  "name": "woocommerce-ai-skills",
  "version": "1.0.0",
  "description": "Community-maintained AI agent skills for operating WooCommerce stores — products, orders, customers, coupons, finance, and more",
  "private": true,
  "license": "MIT",
  "author": "navarroido & Community Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/navarroido/Woocommerce-skill.git"
  },
  "homepage": "https://github.com/navarroido/Woocommerce-skill#readme",
  "bugs": {
    "url": "https://github.com/navarroido/Woocommerce-skill/issues"
  },
  "keywords": [
    "woocommerce",
    "wordpress",
    "ai-toolkit",
    "mcp",
    "skills",
    "claude",
    "cursor",
    "cline",
    "codex",
    "gemini",
    "agents",
    "ecommerce",
    "store-management",
    "rest-api"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "validate": "node scripts/validate-skill.mjs",
    "lint": "markdownlint-cli2 \"skills/**/*.md\" \"docs/**/*.md\"",
    "build:catalog": "node scripts/build-catalog.mjs",
    "scaffold": "bash scripts/scaffold.sh",
    "validate:index": "node scripts/validate-api-index.mjs",
    "test": "node scripts/validate-skill.mjs && markdownlint-cli2 \"skills/**/*.md\""
  },
  "devDependencies": {
    "glob": "^11.1.0",
    "gray-matter": "^4.0.3",
    "markdownlint": "^0.37.4",
    "markdownlint-cli2": "^0.17.2"
  }
}
